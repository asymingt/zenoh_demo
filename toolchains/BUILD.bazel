load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_rust_bindgen//:defs.bzl", "rust_bindgen_toolchain")

# Exposes libc++ as provided by our C++ toolchain so it can be used by rust bindgen.
cc_import(
    name = "libc++",
    shared_library =
        "@@toolchains_llvm++llvm+llvm_toolchain_llvm//:lib/x86_64-unknown-linux-gnu/libc++.so.1",
)

# Exposes libclang as provided by our C++ toolchain so it can be used by rust bindgen.
cc_import(
    name = "libclang",
    shared_library =
        "@@toolchains_llvm++llvm+llvm_toolchain_llvm//:lib/libclang.so",
)

rust_bindgen_toolchain(
    name = "bindgen_llvm_toolchain_impl",
    bindgen = "@rules_rust_bindgen//3rdparty:bindgen",
    clang = "@@toolchains_llvm++llvm+llvm_toolchain_llvm//:bin/clang",
    libclang = ":libclang",
    libstdcxx = ":libc++",
)

toolchain(
    name = "bindgen_llvm_toolchain",
    toolchain = ":bindgen_llvm_toolchain_impl",
    toolchain_type = "@rules_rust_bindgen//:toolchain_type"
)