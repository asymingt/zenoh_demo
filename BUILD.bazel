load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":tools.bzl", "remap_runfiles")

# This symlinks all the plugins into the runfiles directory.

remap_runfiles(
    name = "zenoh_plugins",
    srcs = [
        "@zenoh//plugins/zenoh-plugin-rest:zenoh_plugin_rest",
        "@zenoh//plugins/zenoh-plugin-storage-manager:zenoh_plugin_storage_manager",
        "@zenoh-backend-filesystem//:zenoh_backend_fs",
    ]
)

# Launch zenohd with custom plugins and config.

sh_binary(
    name = "zenohd",
    srcs = ["zenohd.sh"],
    data = [
        ":zenoh_plugins", # plugins
        ":zenohd.json5", # configuration
        "@zenoh//zenohd", # executable
    ],
    args = [
        "$(location @zenoh//zenohd)",
        "$(location :zenohd.json5)",
    ],
    tags = ["requires-network"],
)